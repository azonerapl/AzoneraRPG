  m_EditorClassIdentifier: Azonera.Runtime::Azonera.NPC.NPCInteractable
  NpcName: Guide Alwin
  DialogueLines:
  - "Witaj, w\u0119drowcze. Witaj w Azonerze."
  - "Te ziemie nie s\u0105 bezpieczne \u2014 poza wiosk\u0105 czaj\u0105 si\u0119 bestie."
  - "We\u017A miecz, zabij kilka z nich i wr\xF3\u0107 silniejszy."
  - "Powodzenia. B\u0119d\u0119 tu, gdyby\u015B potrzebowa\u0142 rady."
  _interactionRange: 3.5
